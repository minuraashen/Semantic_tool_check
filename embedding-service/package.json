{
  "name": "embedding-service",
  "version": "2.0.0",
  "description": "Background embedding service for WSO2 MI XML files with periodic watching",
  "main": "dist/embedding-service/index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/embedding-service/index.js",
    "dev": "ts-node src/embedding-service/index.ts",
    "search": "ts-node src/retrieval/search.ts",
    "search:bm25": "ts-node src/retrieval/search-bm25.ts",
    "search:compare": "ts-node src/retrieval/search-compare.ts",
    "bm25:backfill": "ts-node src/retrieval/backfill-fts.ts",
    "ground-truth:build": "ts-node src/retrieval/build-ground-truth.ts",
    "test:compare": "ts-node src/retrieval/test-runner.ts"
  },
  "keywords": [
    "embedding",
    "vector",
    "search",
    "onnx",
    "wso2",
    "xml"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^9.2.2",
    "fast-xml-parser": "^4.3.2",
    "glob": "^13.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}